rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /backpack/{userId} {
      allow read: if true;
      allow create: if true;
      allow delete: if isOwner(userId);
      allow update: if isOwner(userId) || (
        // Allow updating shared fields (courseDonations, enrollmentRequests, submissions, etc.)
        // as long as sensitive personalInformation is not modified
        !('user' in request.resource.data) ||
        !('user' in resource.data) ||
        !('personalInformation' in resource.data.user) ||
        request.resource.data.user.personalInformation == resource.data.user.personalInformation
      );
    }

    match /backpack/{userId}/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
